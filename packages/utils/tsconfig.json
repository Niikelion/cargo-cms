{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "baseUrl": "../../",
    "rootDir": "./",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist", "test"]
}
